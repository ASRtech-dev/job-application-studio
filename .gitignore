# Dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# Next.js & Build artifacts
/.next/
/.next-*/
/out/
/build
/coverage
*.tsbuildinfo
