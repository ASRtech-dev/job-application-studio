!/data/.gitkeep
/exports/
/.local/
/public/uploads/*
!/public/uploads/.gitkeep
/public/documents/*
!/public/documents/.gitkeep
/*.pdf

# Secrets, Certificates & Local Env
.env*
!.env.example
*.pem
*.key
*.pfx
*.p12

# OS & Editor files
.DS_Store
Thumbs.db
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*
.vercel
