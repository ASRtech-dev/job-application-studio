{
  "name": "job-application-studio",
  "version": "2.0.0",
  "description": "Local-first AI-assisted CV, Cover Letter, and Job Search CRM Studio with ATS evidence auditing and pixel-accurate A4 PDF compilation.",
  "license": "MIT",
  "private": true,
  "engines": {
    "node": ">=20.0.0"
  },
  "scripts": {
    "setup": "node scripts/setup.mjs",
    "dev": "next dev --webpack -H 127.0.0.1 -p 3000",
    "build": "next build --webpack",
    "start": "next start -H 127.0.0.1 -p 3000",
    "use": "node scripts/use-local.mjs",
    "lint": "eslint",
    "typecheck": "tsc --noEmit --incremental false",
    "test": "node --test tests/*.test.mjs",
    "test:security": "node --test tests/security.test.mjs tests/security-pdf.integration.mjs",
    "check:pii": "node scripts/check-pii-leak.mjs",
    "install:chromium": "playwright install chromium",
    "backup": "node scripts/data-backup.mjs"
  },
  "dependencies": {
    "@fontsource/ibm-plex-sans": "^5.3.0",
    "@fontsource/ibm-plex-serif": "^5.3.0",
    "@fontsource/inter": "^5.3.0",
    "@fontsource/plus-jakarta-sans": "^5.3.0",
    "canvas-confetti": "^1.9.4",
    "lucide-react": "^1.16.0",
    "next": "16.4.6",
    "pdf-lib": "^1.17.1",
    "playwright": "^1.60.0",
    "proper-lockfile": "^4.1.2",
    "react": "19.2.4",
    "react-dom": "19.2.4",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "@types/canvas-confetti": "^1.9.0",
    "@types/node": "^20",
    "@types/proper-lockfile": "^4.1.4",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.4.6",
    "tailwindcss": "^4",
    "typescript": "^5"
  },
  "overrides": {
    "brace-expansion": "^5.0.12",
    "minimatch": "^10.2.4",
    "js-yaml": "^4.3.2",
    "browserslist": "^4.28.8",
    "baseline-browser-mapping": "^2.11.2",
    "source-map-js": "^1.2.2"
  }
}
